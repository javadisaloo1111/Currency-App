# ------------------------------------------------------------------
# Talayar Price Gateway — environment configuration
# Copy to `.env` (gitignored) and adjust. NEVER commit real secrets.
# ------------------------------------------------------------------

# HTTP server
PORT=8080
HOST=0.0.0.0

# Polling interval for price providers (ms). 15s = near real-time.
POLL_INTERVAL_MS=15000

# A quote older than this is served with is_stale=true.
STALE_AFTER_MS=300000

# SQLite database file (price history / latest prices / source metrics)
DB_PATH=data/talayar.db

# ---- Price providers -------------------------------------------------

# TGJU ajax.json endpoint hosts, tried in order (automatic failover).
TGJU_HOSTS=https://call5.tgju.org,https://call4.tgju.org,https://call2.tgju.org,https://call.tgju.org

# Nobitex public market stats (USDT/BTC in Toman). No key required.
NOBITEX_ENABLED=true

# Snapshot provider: serves the static GitHub-Pages snapshot produced by
# scripts/snapshot-publisher.mjs. Used as bootstrap/fallback so the gateway
# always has data even when live providers are unreachable.
#   SNAPSHOT_DIR  — local checkout of the gh-pages branch
#   SNAPSHOT_URL  — remote URL of the static API (optional, takes precedence)
SNAPSHOT_DIR=
SNAPSHOT_URL=
SNAPSHOT_IMPORT_HISTORY=true

# ---- Hardening --------------------------------------------------------

# Per-IP rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Provider fetch timeout (ms)
FETCH_TIMEOUT_MS=12000
